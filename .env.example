# TALA Voice — Hermes agent, Next.js frontend, Supabase (PostgreSQL)

# Connection string from your Supabase project:
#   Settings → Database → Connection string → URI
#   Format: postgresql://postgres.[random]:[password]@db.[project].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Hermes backend (TALA profile) — usually http://127.0.0.1:8650
# HERMES_URL is not required; it defaults to 127.0.0.1:8650 in src/lib/hermes.ts

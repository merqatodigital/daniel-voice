# TALA Voice — OpenRouter chat, Next.js frontend, PostgreSQL

# Connection string from your PostgreSQL instance:
#   Local: postgresql://postgres:password@localhost:5432/tala
#   Supabase: Settings → Database → Connection string → URI
DATABASE_URL=


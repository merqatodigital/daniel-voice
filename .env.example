# ── Required ───────────────────────────────────────────────────────────────
# Postgres. Local: postgres://tala:tala@127.0.0.1:5432/tala
# Vercel: leave unset and let the Neon/Vercel Postgres integration provide it
#         (it is injected automatically at build and runtime).
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/tala

# Force TLS even when the URL omits ?sslmode=require (required for Neon/Supabase).
# Leave unset/false for a local Postgres.
DATABASE_SSL=false

# ── Optional: free OpenAI-compatible LLM (any of these work) ─────────────────
# Set ONLY ONE of the *_API_KEY values. Base URLs for popular free tiers:
#   Groq            https://api.groq.com/openai/v1        (llama-3.3-70b-versatile)
#   Cerebras        https://api.cerebras.ai/v1            (llama3.1-8b)
#   SambaNova       https://api.sambanova.ai/v1           (Meta-Llama-3.3-70B-Instruct)
#   OpenRouter free https://openrouter.ai/api/v1          (…:free models; or paste the
#                   key in Setup instead — that path stores it in Postgres)
#   Ollama via URL  (leave these unset; use Setup → Ollama and a reachable URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Anthropic (paid) — only used if OPENAI_* and OpenRouter are unset
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Override the OpenRouter endpoint if you proxy it (rare)
OPENROUTER_BASE_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Remote browser-voice model repo (needs CORS). Only for non-LAN/remote installs.
TA
</content>
